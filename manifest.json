{
  "manifest_version": 3,
  "name": "Tab Overview",
  "version": "1.0.0",
  "description": "Replace the new tab page with a calm overview of every open tab, tab group, and window.",
  "minimum_chrome_version": "104",
  "offline_enabled": true,
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "favicon",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
